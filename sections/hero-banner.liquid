{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

<section
  id="hero-banner-{{ section.id }}"
  class="hero-banner"
  style="
    --hero-height: {{ section.settings.height }}px;
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-text-color: {{ section.settings.text_color }};
  "
>
  {%- if section.settings.image != blank -%}
    <div class="hero-banner__media">
      {{
        section.settings.image
        | image_url: width: 1920
        | image_tag:
          class: 'hero-banner__image',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '375, 550, 750, 1100, 1500, 1760, 1920',
          sizes: '100vw'
      }}
    </div>
  {%- else -%}
    <div class="hero-banner__media hero-banner__media--placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-banner__placeholder' }}
    </div>
  {%- endif -%}

  <div class="hero-banner__overlay"></div>

  <div class="hero-banner__content">
    {%- if section.settings.subheading != blank -%}
      <p class="hero-banner__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hero-banner__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="hero-banner__btn btn btn--{{ section.settings.button_style }}"
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  .hero-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.content_alignment }};
    min-height: var(--hero-height);
    overflow: hidden;
    color: var(--hero-text-color);
  }

  .hero-banner__media,
  .hero-banner__media--placeholder {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-banner__media--placeholder svg {
    width: 100%;
    height: 100%;
  }

  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: rgba(0, 0, 0, var(--hero-overlay));
  }

  .hero-banner__content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    padding: 3rem 2rem;
    text-align: {{ section.settings.text_alignment }};
  }

  .hero-banner__subheading {
    font-size: 0.875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
    opacity: 0.85;
  }

  .hero-banner__heading {
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .hero-banner__text {
    font-size: 1.125rem;
    margin: 0 0 1.75rem;
    opacity: 0.9;
  }

  .hero-banner__btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: opacity 0.2s;
  }

  .hero-banner__btn:hover {
    opacity: 0.85;
  }

  .btn--primary {
    background-color: var(--hero-text-color);
    color: #000;
  }

  .btn--outline {
    border: 2px solid var(--hero-text-color);
    color: var(--hero-text-color);
    background: transparent;
  }

  @media (max-width: 749px) {
    .hero-banner {
      justify-content: center;
    }
    .hero-banner__content {
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Hero / Bannière",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de fond"
    },
    {
      "type": "range",
      "id": "height",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "label": "Hauteur de la section",
      "default": 600
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Opacité du voile sombre",
      "default": 30
    },
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Nouveauté"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal",
      "default": "Bienvenue dans notre boutique"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte descriptif",
      "default": "<p>Découvrez notre sélection exclusive de produits.</p>"
    },
    {
      "type": "header",
      "content": "Bouton"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Découvrir"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style du bouton",
      "options": [
        { "value": "primary", "label": "Plein" },
        { "value": "outline", "label": "Contour" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignement horizontal du contenu",
      "options": [
        { "value": "flex-start", "label": "Gauche" },
        { "value": "center", "label": "Centre" },
        { "value": "flex-end", "label": "Droite" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignement du texte",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Droite" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Hero / Bannière"
    }
  ]
}
{% endschema %}
