<section
  id="category-grid-{{ section.id }}"
  class="category-grid section-{{ section.id }}"
>
  {%- if section.settings.heading != blank -%}
    <div class="category-grid__header">
      <h2 class="category-grid__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="category-grid__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="category-grid__grid" style="--cols: {{ section.settings.columns }};">
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="category-grid__item"
        {{ block.shopify_attributes }}
      >
        <div class="category-grid__media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 600
              | image_tag:
                class: 'category-grid__image',
                loading: 'lazy',
                widths: '300, 400, 600',
                sizes: '(min-width: 990px) calc(100vw / {{ section.settings.columns }}), (min-width: 750px) 50vw, 100vw'
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'category-grid__placeholder' }}
          {%- endif -%}
          <div class="category-grid__overlay"></div>
        </div>
        <div class="category-grid__label">
          <span class="category-grid__name">{{ block.settings.label | default: 'Catégorie' }}</span>
          {%- if block.settings.product_count != blank -%}
            <span class="category-grid__count">{{ block.settings.product_count }} produits</span>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_all_link and section.settings.all_link != blank -%}
    <div class="category-grid__footer">
      <a href="{{ section.settings.all_link }}" class="category-grid__all-link">
        {{ section.settings.all_link_label | default: 'Voir toutes les catégories' }}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  {%- endif -%}
</section>

<style>
  .category-grid {
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
    max-width: 1400px;
    margin: 0 auto;
  }
  .category-grid__header { text-align: center; margin-bottom: 2.5rem; }
  .category-grid__heading { font-size: clamp(1.5rem, 3vw, 2.25rem); margin: 0 0 0.5rem; }
  .category-grid__subheading { color: #666; font-size: 1rem; margin: 0; }
  .category-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 989px) { .category-grid__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 479px) { .category-grid__grid { grid-template-columns: 1fr 1fr; gap: 0.75rem; } }
  .category-grid__item {
    display: block; text-decoration: none; color: inherit;
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden; position: relative;
    aspect-ratio: {{ section.settings.aspect_ratio }};
  }
  .category-grid__media { position: absolute; inset: 0; }
  .category-grid__image, .category-grid__placeholder {
    width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;
  }
  .category-grid__item:hover .category-grid__image,
  .category-grid__item:hover .category-grid__placeholder { transform: scale(1.05); }
  .category-grid__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.1) 60%, transparent 100%);
  }
  .category-grid__label {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 1.25rem 1rem 1rem;
    display: flex; flex-direction: column; gap: 0.2rem;
    color: #fff; z-index: 1;
  }
  .category-grid__name { font-size: 1.05rem; font-weight: 700; line-height: 1.2; }
  .category-grid__count { font-size: 0.8rem; opacity: 0.8; }
  .category-grid__footer { text-align: center; margin-top: 2rem; }
  .category-grid__all-link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.95rem; font-weight: 600; text-decoration: none; color: inherit;
    border-bottom: 2px solid currentColor; padding-bottom: 2px; transition: opacity 0.2s;
  }
  .category-grid__all-link:hover { opacity: 0.7; }
</style>

{% schema %}
{
  "name": "Grille de catégories",
  "tag": "section",
  "class": "section-category-grid",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Parcourir par catégorie" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Trouvez exactement ce que vous cherchez" },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Colonnes (bureau)", "default": 4 },
    { "type": "select", "id": "aspect_ratio", "label": "Ratio", "options": [{"value":"1/1","label":"Carré"},{"value":"4/3","label":"Paysage"},{"value":"3/4","label":"Portrait"},{"value":"16/9","label":"Large"}], "default": "3/4" },
    { "type": "range", "id": "border_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Arrondi", "default": 8 },
    { "type": "checkbox", "id": "show_all_link", "label": "Afficher le lien Tout voir", "default": true },
    { "type": "url", "id": "all_link", "label": "Lien Tout voir" },
    { "type": "text", "id": "all_link_label", "label": "Texte du lien", "default": "Voir toutes les catégories" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacement haut", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacement bas", "default": 60 }
  ],
  "blocks": [{
    "type": "category", "name": "Catégorie",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "label", "label": "Nom", "default": "Électronique" },
      { "type": "text", "id": "product_count", "label": "Nombre de produits" },
      { "type": "url", "id": "link", "label": "Lien" }
    ]
  }],
  "presets": [{
    "name": "Grille de catégories",
    "blocks": [
      {"type":"category","settings":{"label":"Électronique"}},
      {"type":"category","settings":{"label":"Mode"}},
      {"type":"category","settings":{"label":"Maison & Jardin"}},
      {"type":"category","settings":{"label":"Sport"}}
    ]
  }]
}
{% endschema %}
