<section
  id="promo-banner-{{ section.id }}"
  class="promo-banner section-{{ section.id }}"
  style="--promo-bg: {{ section.settings.background_color }}; --promo-color: {{ section.settings.text_color }}; --promo-accent: {{ section.settings.accent_color }};"
>
  <div class="promo-banner__inner">
    {%- if section.settings.show_countdown and section.settings.end_date != blank -%}
      <div class="promo-banner__countdown" data-end="{{ section.settings.end_date }}">
        <div class="countdown__unit"><span class="countdown__value" data-days>00</span><span class="countdown__label">Jours</span></div>
        <span class="countdown__sep">:</span>
        <div class="countdown__unit"><span class="countdown__value" data-hours>00</span><span class="countdown__label">Heures</span></div>
        <span class="countdown__sep">:</span>
        <div class="countdown__unit"><span class="countdown__value" data-minutes>00</span><span class="countdown__label">Min</span></div>
        <span class="countdown__sep">:</span>
        <div class="countdown__unit"><span class="countdown__value" data-seconds>00</span><span class="countdown__label">Sec</span></div>
      </div>
    {%- endif -%}
    <div class="promo-banner__content">
      {%- if section.settings.badge != blank -%}<span class="promo-banner__badge">{{ section.settings.badge }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="promo-banner__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="promo-banner__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="promo-banner__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="promo-banner__btn promo-banner__btn--primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a href="{{ section.settings.secondary_button_link | default: '#' }}" class="promo-banner__btn promo-banner__btn--secondary">{{ section.settings.secondary_button_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.discount_code != blank -%}
        <div class="promo-banner__code-wrap">
          <span class="promo-banner__code-label">Code promo :</span>
          <button class="promo-banner__code" onclick="navigator.clipboard.writeText('{{ section.settings.discount_code }}').then(()=>{ this.textContent='Copié !'; setTimeout(()=>{ this.textContent='{{ section.settings.discount_code }}'; },2000); })" aria-label="Copier le code promo">{{ section.settings.discount_code }}</button>
        </div>
      {%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <div class="promo-banner__media">
        {{ section.settings.image | image_url: width: 800 | image_tag: class: 'promo-banner__image', loading: 'lazy' }}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.show_countdown and section.settings.end_date != blank -%}
<script>
(function() {
  var end = new Date('{{ section.settings.end_date }}').getTime();
  var el = document.querySelector('#promo-banner-{{ section.id }} .promo-banner__countdown');
  if (!el) return;
  function pad(n) { return String(n).padStart(2, '0'); }
  function tick() {
    var now = Date.now(), diff = Math.max(0, end - now);
    el.querySelector('[data-days]').textContent = pad(Math.floor(diff / 86400000));
    el.querySelector('[data-hours]').textContent = pad(Math.floor((diff % 86400000) / 3600000));
    el.querySelector('[data-minutes]').textContent = pad(Math.floor((diff % 3600000) / 60000));
    el.querySelector('[data-seconds]').textContent = pad(Math.floor((diff % 60000) / 1000));
    if (diff > 0) setTimeout(tick, 1000);
  }
  tick();
})();
</script>
{%- endif -%}

<style>
  .promo-banner { background: var(--promo-bg); color: var(--promo-color); padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px; }
  .promo-banner__inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; gap: 3rem; flex-wrap: wrap; }
  .promo-banner__content { flex: 1; min-width: 280px; display: flex; flex-direction: column; gap: 1rem; }
  .promo-banner__badge { display: inline-block; background: var(--promo-accent); color: #fff; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.3rem 0.75rem; border-radius: 100px; align-self: flex-start; }
  .promo-banner__heading { font-size: clamp(1.75rem, 4vw, 3rem); font-weight: 800; line-height: 1.1; margin: 0; }
  .promo-banner__text { font-size: 1.05rem; opacity: 0.85; margin: 0; max-width: 500px; }
  .promo-banner__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .promo-banner__btn { display: inline-block; padding: 0.8rem 1.75rem; font-size: 0.95rem; font-weight: 700; text-decoration: none; border-radius: 6px; transition: opacity 0.2s, transform 0.1s; cursor: pointer; border: 2px solid transparent; }
  .promo-banner__btn:hover { opacity: 0.85; transform: translateY(-1px); }
  .promo-banner__btn--primary { background: var(--promo-accent); color: #fff; border-color: var(--promo-accent); }
  .promo-banner__btn--secondary { background: transparent; border-color: var(--promo-color); color: var(--promo-color); }
  .promo-banner__code-wrap { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .promo-banner__code-label { font-size: 0.85rem; opacity: 0.75; }
  .promo-banner__code { font-family: monospace; font-size: 0.95rem; font-weight: 700; letter-spacing: 0.1em; padding: 0.35rem 0.9rem; border: 2px dashed var(--promo-color); border-radius: 4px; background: transparent; color: var(--promo-color); cursor: pointer; transition: background 0.2s, color 0.2s; }
  .promo-banner__code:hover { background: var(--promo-color); color: var(--promo-bg); }
  .promo-banner__media { flex: 0 0 auto; width: min(45%, 500px); }
  .promo-banner__image { width: 100%; height: auto; border-radius: 12px; display: block; }
  .promo-banner__countdown { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
  .countdown__unit { display: flex; flex-direction: column; align-items: center; min-width: 52px; background: rgba(255,255,255,0.15); border-radius: 8px; padding: 0.5rem 0.4rem 0.4rem; }
  .countdown__value { font-size: 1.5rem; font-weight: 800; line-height: 1; }
  .countdown__label { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.7; margin-top: 0.2rem; }
  .countdown__sep { font-size: 1.5rem; font-weight: 800; opacity: 0.6; margin-bottom: 1rem; }
  @media (max-width: 749px) { .promo-banner__media { width: 100%; } .promo-banner__inner { flex-direction: column-reverse; gap: 1.5rem; } }
</style>

{% schema %}
{
  "name": "Bannière promotionnelle",
  "tag": "section",
  "class": "section-promo-banner",
  "settings": [
    { "type": "header", "content": "Contenu" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Offre limitée" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Jusqu'à -50% sur tout le site !" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Profitez de nos offres exclusives sur des milliers de produits." },
    { "type": "text", "id": "discount_code", "label": "Code promo", "placeholder": "ex. SOLDES50" },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "En profiter maintenant" },
    { "type": "url", "id": "button_link", "label": "Lien principal" },
    { "type": "text", "id": "secondary_button_label", "label": "Bouton secondaire" },
    { "type": "url", "id": "secondary_button_link", "label": "Lien secondaire" },
    { "type": "header", "content": "Compte à rebours" },
    { "type": "checkbox", "id": "show_countdown", "label": "Afficher le compte à rebours", "default": true },
    { "type": "text", "id": "end_date", "label": "Date de fin (ISO 8601)", "info": "Format: YYYY-MM-DDTHH:MM:SS", "placeholder": "2026-12-31T23:59:59" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background_color", "label": "Fond", "default": "#1e1b4b" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#f59e0b" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Espacement haut", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Espacement bas", "default": 64 }
  ],
  "presets": [{ "name": "Bannière promotionnelle" }]
}
{% endschema %}
